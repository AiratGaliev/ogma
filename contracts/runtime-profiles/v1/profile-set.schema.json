{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogma.dev/contracts/runtime-profiles/v1/profile-set.schema.json",
  "title": "Ogma Runtime Feature Profile Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ecmaEdition",
    "languageSemantics",
    "mandatoryRuntimeMetadata",
    "components",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "ecmaEdition": {
      "const": "ECMAScript-2026"
    },
    "languageSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamicCode",
        "featureGating"
      ],
      "properties": {
        "dynamicCode": {
          "const": "preserved"
        },
        "featureGating": {
          "const": "host-and-tooling-only"
        }
      }
    },
    "mandatoryRuntimeMetadata": {
      "const": [
        "function-identity",
        "code-generation-cache-identity",
        "frame-layout",
        "environment-capture-descriptors",
        "suspension-state",
        "verifier-summary"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "requires",
          "featureFlag",
          "packaging",
          "semanticEffects",
          "stripPolicy",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "semantic-core",
              "runtime",
              "execution-format",
              "execution-backend",
              "host-integration",
              "metadata",
              "developer-tooling",
              "compatibility"
            ]
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "featureFlag": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "packaging": {
            "enum": [
              "linked-runtime",
              "runtime-module",
              "tooling-only",
              "metadata"
            ]
          },
          "semanticEffects": {
            "type": "boolean"
          },
          "stripPolicy": {
            "enum": [
              "never",
              "retain",
              "profile-controlled",
              "release-default-strip"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "buildMode",
          "executionBackend",
          "hostCompatibility",
          "includeRoots",
          "excludeComponents",
          "featureFlags",
          "tooling",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "buildMode": {
            "enum": [
              "debug",
              "development",
              "release"
            ]
          },
          "executionBackend": {
            "enum": [
              "portable-interpreter",
              "hybrid-native"
            ]
          },
          "hostCompatibility": {
            "enum": [
              "none",
              "node"
            ]
          },
          "includeRoots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "excludeComponents": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "featureFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          },
          "tooling": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dapTransport",
              "debuggerApi",
              "hotReload",
              "inspector",
              "inspectorUi",
              "interpreterHooks",
              "profilerHooks",
              "repl"
            ],
            "properties": {
              "dapTransport": {
                "type": "boolean"
              },
              "debuggerApi": {
                "type": "boolean"
              },
              "hotReload": {
                "type": "boolean"
              },
              "inspector": {
                "type": "boolean"
              },
              "inspectorUi": {
                "type": "boolean"
              },
              "interpreterHooks": {
                "type": "boolean"
              },
              "profilerHooks": {
                "type": "boolean"
              },
              "repl": {
                "type": "boolean"
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceDebugMetadata",
              "sourceMaps",
              "debugSymbols",
              "crashArtifacts"
            ],
            "properties": {
              "sourceDebugMetadata": {
                "enum": [
                  "embedded",
                  "stripped"
                ]
              },
              "sourceMaps": {
                "enum": [
                  "embedded",
                  "external",
                  "omitted"
                ]
              },
              "debugSymbols": {
                "enum": [
                  "embedded",
                  "external",
                  "omitted",
                  "not-applicable"
                ]
              },
              "crashArtifacts": {
                "enum": [
                  "embedded",
                  "external",
                  "omitted"
                ]
              }
            }
          }
        }
      }
    }
  }
}
