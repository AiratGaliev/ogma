        "debugSymbols": "embedded",
        "crashArtifacts": "external"
      },
      "featureFlags": [
        "debug.api",
        "debug.interpreter-hooks",
        "debug.source-metadata",
        "execution.bytecode-verifier",
        "execution.interpreter",
        "execution.native-aot",
        "execution.native-root-maps",
        "execution.portable-bytecode",
        "runtime.core",
        "runtime.host-abi",
        "runtime.host-modules",
        "tools.dap-transport",
        "tools.hot-reload",
        "tools.inspector",
        "tools.inspector-ui",
        "tools.profiler-hooks",
        "tools.repl"
      ],
      "aotBuild": {
        "enabled": true,
        "optimization": "balanced",
        "debugInfo": "full",
        "symbols": "embedded"
      }
    },
    {
      "id": "development-test",
      "purpose": "Fast iteration and test diagnostics with metadata, profiler hooks, REPL and Hot Reload.",
