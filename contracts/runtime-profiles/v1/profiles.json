        "codegenUnits": 16,
        "panic": "unwind",
        "strip": "none"
      },
      "aotBuild": {
        "enabled": false,
        "optimization": "not-applicable",
        "debugInfo": "not-applicable",
        "symbols": "not-applicable"
      }
    },
    {
      "id": "portable-interpreter-release",
      "purpose": "Small production package using the portable interpreter and the shared host ABI.",
      "buildMode": "release",
      "executionBackend": "portable-interpreter",
      "hostCompatibility": "none",
