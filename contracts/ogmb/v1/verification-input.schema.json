{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogma.dev/contracts/ogmb/v1/verification-input.schema.json",
  "title": "Ogma decoded bytecode verification input v1",
  "description": "Backend-neutral facts returned by a registered decoder. This contract deliberately does not freeze a bytecode instruction encoding.",
  "type": "object",
  "required": [
    "schema", "version", "encoding_id", "code_sha256", "execution_model",
    "entry", "entry_registers", "instructions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ogma.bytecode-verification" },
    "version": { "const": "1.0.0" },
    "encoding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$"
    },
    "code_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "execution_model": { "enum": ["stack", "register"] },
    "entry": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "entry_registers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instruction" }
    }
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "required": [
        "offset", "size", "opcode", "operation", "operands", "constant_refs",
        "successors", "may_throw", "stack_effect", "register_effects", "argument_count"
      ],
      "additionalProperties": false,
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "operation": {
          "enum": ["nop", "constant", "unary", "binary", "call", "load_local", "store_local", "jump", "branch", "return", "throw"]
        },
        "operands": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "constant_refs": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "successors": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "may_throw": { "type": "boolean" },
        "stack_effect": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/stackEffect" }
          ]
        },
        "register_effects": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/registerEffects" }
          ]
        },
        "argument_count": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 1024 }
          ]
        }
      }
    },
    "stackEffect": {
      "type": "object",
      "required": ["pop", "push"],
      "additionalProperties": false,
      "properties": {
        "pop": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "push": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "registerEffects": {
      "type": "object",
      "required": ["reads", "writes"],
      "additionalProperties": false,
      "properties": {
        "reads": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        },
        "writes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "execution_model": { "const": "stack" } },
        "required": ["execution_model"]
      },
      "then": {
        "properties": {
          "entry_registers": { "maxItems": 0 },
          "instructions": {
            "items": {
              "properties": {
                "stack_effect": { "$ref": "#/$defs/stackEffect" },
                "register_effects": { "type": "null" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "execution_model": { "const": "register" } },
        "required": ["execution_model"]
      },
      "then": {
        "properties": {
          "instructions": {
            "items": {
              "properties": {
                "stack_effect": { "type": "null" },
                "register_effects": { "$ref": "#/$defs/registerEffects" }
              }
            }
          }
        }
      }
    }
  ]
}
